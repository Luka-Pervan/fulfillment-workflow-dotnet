{
  "ConnectionStrings": {
    "Fulfillment": "Data Source=fulfillment.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": false
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Authentication": {
    "Authority": "",
    "Issuer": "fulfillment-local",
    "Audience": "fulfillment-api",
    "SigningKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
